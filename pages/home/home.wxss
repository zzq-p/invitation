/* 邀请函主页样式 */

/* ---------- 导航栏 ---------- */
.back-icon {
  font-size: 48rpx;
  color: var(--gold-light);
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* ---------- 页眉 ---------- */
.hero {
  padding: 24rpx 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-en {
  font-size: 22rpx;
  letter-spacing: 8rpx;
  color: var(--text-faint);
}
.hero-orn {
  margin: 20rpx 0;
}
.hero-title {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: 6rpx;
}
.hero-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  letter-spacing: 4rpx;
}

/* ---------- 请柬正文 ---------- */
.letter {
  margin-top: 36rpx;
  background:
    linear-gradient(180deg, rgba(232, 200, 122, 0.08), rgba(255, 255, 255, 0.03)),
    rgba(20, 26, 61, 0.55);
  padding: 48rpx 42rpx;
}
.letter-salute {
  margin-bottom: 26rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dashed var(--hairline);
}
.salute-text {
  font-size: 30rpx;
  letter-spacing: 2rpx;
  color: var(--gold-light);
}
.letter-body {
  font-size: 30rpx;
  line-height: 2.1;
  color: var(--text);
  letter-spacing: 1.5rpx;
}
.indent {
  text-indent: 2em;
  margin-bottom: 16rpx;
}
.letter-closing {
  margin-top: 22rpx;
  text-align: right;
  color: var(--gold);
  letter-spacing: 4rpx;
}
.letter-foot {
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.sign-org {
  margin-top: 14rpx;
  font-size: 30rpx;
  letter-spacing: 3rpx;
  color: var(--gold-light);
}
.sign-date {
  font-size: 24rpx;
  color: var(--text-faint);
  letter-spacing: 3rpx;
}

/* ---------- 时间地点 ---------- */
.when-row {
  display: flex;
  align-items: stretch;
  gap: 34rpx;
}
.calendar {
  flex-shrink: 0;
  width: 168rpx;
  border-radius: 18rpx;
  border: 1rpx solid var(--gold-soft);
  background: linear-gradient(180deg, rgba(232, 200, 122, 0.16), rgba(232, 200, 122, 0.04));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
}
.cal-month {
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--gold);
}
.cal-day {
  font-size: 84rpx;
  font-weight: 800;
  line-height: 1.1;
}
.cal-week {
  font-size: 22rpx;
  color: var(--text-dim);
  letter-spacing: 2rpx;
}
.when-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 18rpx;
  min-width: 0;
}
.info-line {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}
.info-icon {
  font-size: 30rpx;
  line-height: 1.5;
}
.info-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.5;
}

/* 倒计时 */
.countdown {
  margin-top: 34rpx;
  padding-top: 30rpx;
  border-top: 1rpx dashed var(--hairline);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cd-label {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--text-dim);
  margin-bottom: 20rpx;
}
.cd-boxes {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.cd-box {
  min-width: 86rpx;
  padding: 10rpx 8rpx;
  border-radius: 14rpx;
  background: linear-gradient(180deg, rgba(232, 200, 122, 0.16), rgba(232, 200, 122, 0.05));
  border: 1rpx solid rgba(232, 200, 122, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cd-num {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.1;
}
.cd-unit {
  font-size: 20rpx;
  color: var(--text-dim);
  margin-top: 2rpx;
}
.cd-colon {
  font-size: 36rpx;
  color: var(--gold-soft);
  font-weight: 700;
}

/* ---------- 时间轴 ---------- */
.timeline {
  padding: 36rpx 32rpx 12rpx;
}
.tl-item {
  display: flex;
  align-items: stretch;
}
.tl-axis {
  position: relative;
  width: 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.tl-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 10rpx;
  background: var(--gold);
  box-shadow: 0 0 0 6rpx rgba(232, 200, 122, 0.16);
  flex-shrink: 0;
}
.tl-dot.hl {
  background: linear-gradient(135deg, #fbeebd, #d99a35);
  box-shadow: 0 0 0 8rpx rgba(232, 200, 122, 0.22), 0 0 18rpx rgba(232, 200, 122, 0.6);
}
.tl-line {
  flex: 1;
  width: 2rpx;
  background: linear-gradient(180deg, rgba(232, 200, 122, 0.45), rgba(232, 200, 122, 0.12));
  margin: 6rpx 0;
}
.tl-body {
  flex: 1;
  padding: 0 0 36rpx 22rpx;
  min-width: 0;
}
.tl-head {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.tl-time {
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.tl-title {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--text);
}
.tl-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--text-dim);
  line-height: 1.6;
}

/* ---------- 交通 ---------- */
.traffic-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}
.traffic-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 30rpx 32rpx;
}
.tf-icon {
  font-size: 48rpx;
  line-height: 1.2;
}
.tf-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.tf-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--gold-light);
}
.tf-desc {
  font-size: 25rpx;
  color: var(--text-dim);
  line-height: 1.6;
}

/* ---------- 提示 ---------- */
.tips {
  padding: 34rpx 36rpx 10rpx;
}
.tip-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin-bottom: 26rpx;
}
.tip-num {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 1rpx solid var(--gold-soft);
  color: var(--gold);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 4rpx;
}
.tip-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--text-dim);
}

/* ---------- 底部行动区 ---------- */
.cta {
  margin-top: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.cta-orn {
  margin-bottom: 36rpx;
}
.cta-btn {
  width: 100%;
  margin-bottom: 24rpx;
}
.rsvped {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 28rpx;
  padding: 26rpx 30rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(120, 220, 150, 0.35);
  background: rgba(70, 160, 100, 0.1);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.rsvped-icon {
  font-size: 40rpx;
}
.rsvped-text {
  font-size: 28rpx;
  color: #9fe6b6;
}
.rsvped-sub {
  font-size: 23rpx;
  color: #7fc896;
}

.footer-mark {
  margin-top: 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.fm-emoji {
  font-size: 44rpx;
}
.fm-line {
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: var(--gold-soft);
}
.fm-sub {
  font-size: 21rpx;
  letter-spacing: 3rpx;
  color: var(--text-faint);
  text-align: center;
}
